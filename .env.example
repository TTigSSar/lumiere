# Copy to .env (gitignored). Never commit real values.

# --- G0 probe (discovery only) ---
G0_PORT=8787
# Random dummy value used only to check whether Suisse Line forwards custom headers.
G0_SECRET=

# --- Application (after G0) ---
TOOL_SHARED_SECRET=
SLOT_SIGNING_KEY=
SUISSE_WEBHOOK_SECRET=
GOOGLE_CALENDAR_ID=
# Path to the service-account JSON key file, stored outside the repo.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_STAFF_CHAT_ID=
SALON_TIME_ZONE=Europe/Zurich
# Directory for lumiere.db (waitlist, ADR-004). Empty = data/ under the content root (gitignored).
DATA_DIR=

# --- Suisse Line agent as code (agent/apply.mjs, ADR-013) ---
SUISSE_API_KEY=
# Empty = create a new agent; set to the returned id to PATCH it afterwards.
LUMIERE_AGENT_ID=
