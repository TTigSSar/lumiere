# /opt/lumiere/app.env on the demo server (root:root, mode 600). Names only — never commit values.
# Built by deploy/push-secrets.sh from the local .env; do not edit by hand on the server.

# --- From the local .env ---
TOOL_SHARED_SECRET=
# Never rotate during the demo (docs/limitations.md #6); must equal the laptop value so
# bookings made during development stay cancellable.
SLOT_SIGNING_KEY=
GOOGLE_CALENDAR_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_STAFF_CHAT_ID=

# --- Fixed for the container (match deploy/compose.yml mounts) ---
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=/run/secrets/service-account.json
DATA_DIR=/data

# Not needed on the server: SUISSE_API_KEY, LUMIERE_AGENT_ID (agent/apply.mjs runs on the laptop),
# SUISSE_WEBHOOK_SECRET (webhook deferred, ADR-017).
